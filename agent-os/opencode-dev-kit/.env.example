# Zerupt OpenCode dev kit - environment variables
# Copy this file to .env and fill in only what the founder gave you.

# Neon MCP server (dev branch only). Leave blank to keep the neon MCP server
# disabled in opencode.json. The founder issues a scoped, dev-branch-only key.
NEON_API_KEY=

# Model provider authentication is NOT configured here. This kit ships
# provider-agnostic and does not set or recommend a model. Authenticate your
# own provider via the OpenCode CLI instead:
#   opencode auth login
# (this stores credentials in OpenCode's own config, e.g. for Anthropic,
# OpenAI, OpenRouter, or any other supported provider - never in this file)
