  "roles": [
    {
      "id": "role_001",
      "name": "Super Admin",
      "description": "Full unrestricted access to all modules, branches, and settings. Cannot be edited.",
      "isSystem": true,
      "userCount": 1,
      "permissions": "all"
    },
    {
      "id": "role_002",
      "name": "Admin",
      "description": "Full access to all operational modules and settings except user management and audit logs.",
      "isSystem": true,
      "userCount": 0,
      "permissions": "all_except_admin"
    },
    {
      "id": "role_003",
      "name": "Manager",
      "description": "Access to sales, purchasing, inventory, and reports. Can approve transactions. No accounting or settings access.",
      "isSystem": true,
      "userCount": 1,
      "permissions": [
        { "module": "POS", "actions": ["view", "create", "edit"], "branchScope": "assigned" },
        { "module": "Sales", "actions": ["view", "create", "edit", "approve", "export"], "branchScope": "assigned" },
        { "module": "Purchasing", "actions": ["view", "create", "edit", "approve"], "branchScope": "assigned" },
        { "module": "Inventory", "actions": ["view", "create", "edit", "export"], "branchScope": "assigned" },
        { "module": "Reports", "actions": ["view", "export"], "branchScope": "assigned" }
      ]
    },
    {
      "id": "role_004",
      "name": "Accountant",
      "description": "Full accounting module access. Read-only on sales, purchasing, and inventory. No settings or POS.",
      "isSystem": true,
      "userCount": 1,
      "permissions": [
        { "module": "Accounting", "actions": ["view", "create", "edit", "delete", "export"], "branchScope": "all" },
        { "module": "Sales", "actions": ["view", "export"], "branchScope": "all" },
        { "module": "Purchasing", "actions": ["view", "export"], "branchScope": "all" },
        { "module": "Inventory", "actions": ["view"], "branchScope": "all" },
        { "module": "Reports", "actions": ["view", "create", "export"], "branchScope": "all" }
      ]
    },
    {
      "id": "role_005",
      "name": "Sales Rep",
      "description": "Create and manage quotations and sales orders. No access to invoices, cost prices, accounting, or settings.",
      "isSystem": true,
      "userCount": 1,
      "permissions": [
        { "module": "Sales", "actions": ["view", "create", "edit"], "branchScope": "assigned" },
        { "module": "Inventory", "actions": ["view"], "branchScope": "assigned" }
      ]
    },
    {
      "id": "role_006",
      "name": "Purchasing Officer",
      "description": "Create and manage purchase orders and GRNs. No access to accounting, sales, or settings.",
      "isSystem": true,
      "userCount": 1,
      "permissions": [
        { "module": "Purchasing", "actions": ["view", "create", "edit"], "branchScope": "assigned" },
        { "module": "Inventory", "actions": ["view", "create"], "branchScope": "assigned" }
      ]
    },
    {
      "id": "role_007",
      "name": "Cashier",
      "description": "POS access only — open/close shifts, process sales and returns. No back-office access.",
      "isSystem": true,
      "userCount": 2,
      "permissions": [
        { "module": "POS", "actions": ["view", "create"], "branchScope": "assigned" }
      ]
    },
    {
      "id": "role_008",
      "name": "Warehouse Staff",
      "description": "Inventory operations — stock adjustments, transfers, and GRN receiving. Read-only on other modules.",
      "isSystem": true,
      "userCount": 1,
      "permissions": [
        { "module": "Inventory", "actions": ["view", "create", "edit"], "branchScope": "assigned" },
        { "module": "Purchasing", "actions": ["view"], "branchScope": "assigned" }
      ]
    },
    {
      "id": "role_009",
      "name": "Viewer",
      "description": "Read-only access across all modules. Cannot create, edit, approve, or delete anything.",
