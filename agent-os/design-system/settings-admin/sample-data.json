{
  "_meta": {
    "models": {
      "organisation": "The top-level tenant/company record — identity, registration, fiscal config, and document numbering.",
      "taxFramework": "A country-specific tax framework preset with its components and rules. Loaded when a country is selected.",
      "taxComponent": "An individual tax rate within a framework (e.g. CGST, SGST, VAT). Multiple components combine into tax groups.",
      "taxGroup": "A named combination of tax components that can be applied to transactions (e.g. Standard GST = CGST 9% + SGST 9%).",
      "branch": "A physical business location. Each branch can have its own currency, tax overrides, hours, and staff.",
      "user": "A person who accesses the system. Has a role, branch access list, and invitation status.",
      "role": "A named permission set defining what a user can see and do per module, action, and branch.",
      "permission": "A single capability within a role: module + action + scope (all branches or specific).",
      "currency": "A supported currency with exchange rate history.",
      "exchangeRate": "A dated exchange rate for a currency pair, entered manually or auto-fetched.",
      "notificationEvent": "A system event that can trigger notifications. Configured at global level, overridden per user.",
      "auditLogEntry": "An immutable record of a system action — user, entity, action type, before/after snapshot.",
      "importJob": "A data import task — entity type, status, row count, error report.",
      "apiKey": "A named API credential with defined scopes and optional expiry.",
      "webhook": "A configured outbound event subscription posting to an external URL.",
      "integration": "A third-party connector (payment, shipping, e-commerce) with connection status."
    },
    "relationships": [
      "Organisation is the root tenant; all other entities belong to it",
      "Branch belongs to Organisation; each Branch has currency override and tax overrides",
      "User belongs to Organisation and has one Role; access is scoped to one or more Branches",
      "Role contains many Permissions (module × action × branch scope)",
      "TaxFramework belongs to a country; it contains many TaxComponents",
      "TaxGroup groups multiple TaxComponents into a single selectable code",
      "ExchangeRate belongs to Currency and has an effective date",
      "AuditLogEntry references a User and an entity within the Organisation",
      "ImportJob references an entity type (Item, Customer, Supplier, etc.)",
      "ApiKey belongs to Organisation with named scopes",
      "Webhook belongs to Organisation and targets a URL for specific events"
    ]
  },

